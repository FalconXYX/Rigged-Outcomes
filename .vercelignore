# site, the Worker, the tests, the docs and anything secret. The function needs only api/, backend/, watchlist/,
# pipeline/, markets.json and requirements.txt.
data/
web/
worker/
tests/
docs/
scripts/
.github/
.ruff_cache/
.pytest_cache/
