{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": { "main": true, "**": false } },
  "functions": {
    "api/step.py": {
      "maxDuration": 300,
      "includeFiles": "{backend/**,watchlist/**,pipeline/**,markets.json}"
    }
  },
  "routes": [
    { "src": "^/api/step$", "missing": [{ "type": "header", "key": "x-ro-wake", "value": "^v1,[0-9]{9,11},(main|news|model|add),[0-9a-f]{16},[0-9a-f]{64}$" }], "mitigate": { "action": "deny" } },
    { "src": "^/(?!api/step$).*", "mitigate": { "action": "deny" } }
  ]
}
