# Local values for `wrangler dev` (copy to .dev.vars, which git ignores). Never put real secrets here.
# The Turnstile secret is Cloudflare's test secret that always passes (with the dummy token XXXX.DUMMY.TOKEN.XXXX).
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
OWNER_TOKEN=dev-owner-token
JOB_TOKEN=dev-job-token
VISITOR_SALT=dev-salt
DEV=on
TURNSTILE_STRICT=off
ALLOWED_ORIGINS=http://localhost:5190,http://127.0.0.1:5190,http://localhost:5173
