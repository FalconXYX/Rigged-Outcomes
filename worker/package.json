{
  "name": "rigged-outcomes-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788 --ip 127.0.0.1 --persist-to \"${WRANGLER_STATE:-.wrangler/state}\"",
    "migrate:local": "wrangler d1 migrations apply rigged-outcomes --local --persist-to \"${WRANGLER_STATE:-.wrangler/state}\"",
    "typecheck": "tsc --noEmit",
    "unit": "node test/unit.mjs",
    "smoke": "node test/smoke.mjs http://localhost:8788",
    "test": "node test/run.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.162.0"
  }
}
